    .topbar .topbar-right .mode-toggle[title="大屏模式"] { display:none !important; }
    /* 左下角账号区已移除（需求③：删掉账号展示/账号管理/关闭按钮） */
    .sidebar-footer { display:none !important; }
    /* 需求②：展开子级后导航内容溢出 → 撑高文档使整页可滚 → 侧栏被顶出视口、其 border-right(分割线) 不到底。
       修复：导航在侧栏内部滚动（min-height:0 让 flex 项可收缩 + overflow-y:auto），侧栏恒为满高，分割线始终通到底。 */
    .sidebar { overflow:hidden !important; }
    .sidebar-nav { min-height:0 !important; overflow-y:auto !important; }
    /* 监控中心父级 + 设备管理子级（需求②） */
