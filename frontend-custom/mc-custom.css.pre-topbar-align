/* ══ rm-collapse-btn 去折叠按钮 ══ */
/* ===RM-COLLAPSE 2026-09-07=== 移除左上角折叠侧栏功能（需求：删掉折叠按钮） */
/* 1) 隐藏顶部品牌区的折叠按钮 —— 这是页面上唯一能触发折叠的入口 */
.sidebar-brand .collapse-btn{display:none!important}
/* 2) 页脚折叠按钮（原已随页脚隐藏）一并禁用，双保险 */
.sidebar-footer .collapse-btn{display:none!important}
/* 3) 兜底：即便其它代码误触发 collapsed 类，也强制保持侧栏展开、导航文字可见，
       .main-area 为 flex:1 自适应，宽度恒为 220px 不影响右侧内容布局（彻底删除折叠行为） */
.sidebar.collapsed{width:220px!important;min-width:220px!important}
/* 品牌标题（智能监控平台）：Vue 用 v-show 内联 display:none 隐藏，用 !important 压回显示 */
.sidebar.collapsed .brand-text{display:block!important}
.sidebar.collapsed .nav-label,
.sidebar.collapsed .nav-text,
.sidebar.collapsed .nav-sub,
.sidebar.collapsed .nav-indicator,
.sidebar.collapsed .nav-group-title{opacity:1!important;pointer-events:auto!important}
/* ══ rm-topbar-time 去顶栏时间 ══ */
/* ===RM-TOPBAR-TIME 2026-09-07=== 移除右上角时间展示（需求） */
.topbar .topbar-right .topbar-time{display:none!important}

/* ===MC-MACH-VIEW 2026-09-16=== 设备管理「列表 / 卡片」视图切换
   需求：/machines 加一个切换按钮，把表格列表变成「监控详情 /monitor」那种卡片。
   说明：.machine-mini-card / .mini-metrics 的「外观」（白底/描边/圆角/内边距/悬浮）已由
        本文件上方既有规则提供，此处只补「内部子元素布局」+ 网格容器 + 切换控件。
        颜色全走 --mc-* 令牌，明暗主题自适应；仅状态点/进度条用固定语义色（与监控详情一致）。
*/
/* 切换控件：绝对定位挂 page-header 右侧，不动原生文档流 */
.main-area .machines-page .page-header{position:relative}
.main-area .mc-view-switch{position:absolute;right:0;top:50%;transform:translateY(-50%);display:inline-flex;align-items:center;gap:2px;background:var(--mc-bg-2);border:1px solid var(--mc-border-strong);border-radius:9px;padding:2px}
.main-area .mc-view-switch .mc-vs-btn{display:inline-flex;align-items:center;justify-content:center;width:30px;height:26px;border:0;border-radius:7px;background:transparent;color:var(--mc-text-3);cursor:pointer;transition:background .15s,color .15s}
.main-area .mc-view-switch .mc-vs-btn svg{width:15px;height:15px}
.main-area .mc-view-switch .mc-vs-btn:hover{color:var(--mc-text)}
.main-area .mc-view-switch .mc-vs-btn.is-active{background:var(--mc-bar-1);color:#fff}

/* 卡片网格容器（4 列 @桌面；窄屏自动降列） */
.main-area .mc-card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;margin-bottom:14px}
.main-area .mc-card-grid .mc-card-empty{grid-column:1/-1;padding:44px 0;text-align:center;color:var(--mc-text-3);font-size:13px}
.main-area .mc-card-grid .machine-mini-card{display:block;cursor:pointer;opacity:0;animation:mcStatFade .5s cubic-bezier(.16,1,.3,1) both;animation-delay:calc(var(--i,0)*.05s)}

/* 卡片内部布局（对齐监控详情 .machine-mini-card）
   ⚠ 必须收窄到 .mc-card-grid 作用域：/monitor 页原生卡片用的是同名 class，
   而 Vue scoped 只给末级选择器加 [data-v-*]，与本文件同特异性时「后加载者胜」——
   若写成全局 `.main-area .mini-*`，会把 /monitor 的 label 字号(12→11px/宽32→34px)
   与在线点光晕(box-shadow 0 0 6px→0 0 0 3px)一并改掉（2026-09-16 发现并修正）。 */
.main-area .mc-card-grid .mini-header{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.main-area .mc-card-grid .mini-name{flex:1 1 auto;min-width:0;font-size:15px;font-weight:600;color:var(--mc-text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.main-area .mc-card-grid .status-dot{width:8px;height:8px;flex:0 0 8px;border-radius:50%;background:var(--mc-text-3)}
.main-area .mc-card-grid .status-dot.online{background:#52c41a;box-shadow:0 0 0 3px rgba(82,196,26,.15)}
.main-area .mc-card-grid .status-dot.offline{background:#c0c4cc;box-shadow:0 0 0 3px rgba(192,196,204,.18)}
.main-area .mc-card-grid .mini-ip{font-size:12px;color:var(--mc-text-2);margin-bottom:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.main-area .mc-card-grid .mini-metrics{display:flex;flex-direction:column;gap:6px}
.main-area .mc-card-grid .mini-metric{display:flex;align-items:center;gap:8px}
.main-area .mc-card-grid .mini-metric .label{flex:0 0 34px;font-size:11px;letter-spacing:.04em;color:var(--mc-text-3)}
.main-area .mc-card-grid .mini-metric .mc-prog{flex:1 1 auto;min-width:0}
.main-area .mc-card-grid .mini-metric .mc-prog-outer{display:block;height:6px;border-radius:100px;background:rgba(148,163,184,.28);overflow:hidden}
.main-area .mc-card-grid .mini-metric .mc-prog-inner{display:block;height:6px;border-radius:100px;transition:width .45s cubic-bezier(.16,1,.3,1)}
.main-area .mc-card-grid .mini-metric .mc-prog-txt{flex:0 0 48px;text-align:right;font-size:12px;color:var(--mc-text-2);font-variant-numeric:tabular-nums}

/* hover 浮出的「编辑」入口：默认 width:0 隐藏（静态视觉与监控详情卡片 100% 一致），悬停才展开 */
.main-area .mc-card-grid .mc-mini-edit{display:inline-flex;align-items:center;justify-content:center;width:0;flex:0 0 0;height:22px;padding:0;overflow:hidden;opacity:0;border:0;background:transparent;color:var(--mc-text-3);border-radius:6px;cursor:pointer;transition:width .18s,flex-basis .18s,opacity .18s,color .15s}
.main-area .mc-card-grid .mc-mini-edit svg{width:14px;height:14px;flex:0 0 14px}
.main-area .mc-card-grid .machine-mini-card:hover .mc-mini-edit{width:24px;flex-basis:24px;opacity:1}
.main-area .mc-card-grid .mc-mini-edit:hover{color:var(--mc-bar-1)}
@media (prefers-reduced-motion:reduce){.main-area .mc-card-grid .machine-mini-card{animation:none!important;opacity:1!important}}

/* ══ MC-MACH-GROUPS 设备管理「按分组」视图（2026-09-17 新增）══
   数据源 /api/advanced/group-stats；外观复用 .machine-mini-card 基础规则，
   ⚠ 内部布局必须收窄到 .mc-group-grid（与 .mc-card-grid 同理，避免污染 /monitor 原生同名 class） */
.main-area .mc-group-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;margin-bottom:14px}
.main-area .mc-group-grid .mc-card-empty{grid-column:1/-1;padding:44px 0;text-align:center;color:var(--mc-text-3);font-size:13px}
.main-area .mc-group-grid .machine-mini-card{display:block;cursor:pointer;opacity:0;animation:mcStatFade .5s cubic-bezier(.16,1,.3,1) both;animation-delay:calc(var(--i,0)*.05s)}
.main-area .mc-group-grid .mini-header{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.main-area .mc-group-grid .mini-name{flex:1 1 auto;min-width:0;font-size:15px;font-weight:600;color:var(--mc-text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.main-area .mc-group-grid .mc-group-rate{flex:0 0 auto;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
.main-area .mc-group-grid .mini-ip{font-size:12px;color:var(--mc-text-2);margin-bottom:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.main-area .mc-group-grid .mini-metrics{display:flex;align-items:center;gap:8px}
.main-area .mc-group-grid .mini-metrics .label{flex:0 0 34px;font-size:11px;letter-spacing:.04em;color:var(--mc-text-3)}
.main-area .mc-group-grid .mini-metrics .mc-prog{flex:1 1 auto;min-width:0}
.main-area .mc-group-grid .mini-metrics .mc-prog-outer{display:block;height:6px;border-radius:100px;background:rgba(148,163,184,.28);overflow:hidden}
.main-area .mc-group-grid .mini-metrics .mc-prog-inner{display:block;height:6px;border-radius:100px;transition:width .45s cubic-bezier(.16,1,.3,1)}
.main-area .mc-group-grid .mini-metrics .mc-prog-txt{flex:0 0 52px;text-align:right;font-size:12px;color:var(--mc-text-2);font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion:reduce){.main-area .mc-group-grid .machine-mini-card{animation:none!important;opacity:1!important}}

/* ══ MC-MD-COMPARE 设备详情「同环比对比」panel ══
 * 2026-09-17 新增。全部选择器收窄在 .mdc-panel / #mc-md-compare 内，
 * 绝不做全局覆盖（遵循 mc-custom.css 的 scoped 双向边界铁律）。
 * 颜色一律走平台既有 CSS 变量，无变量时给与原生 .chart-panel 一致的兜底色。 */
/* ⚠ 原生 .main-area .chart-row 在 mc-custom.css 里已被改成
 *   grid-template-columns: repeat(auto-fit, minmax(220px, 1fr))
 *   4 个原生面板占满后，auto-fit 会再生成一个 **0px 宽的幽灵轨道**，
 *   此时 `span 2` 会落进幽灵轨道 → 面板被压成单列宽（658px）。
 *   修法：显式声明占满**全部**轨道（-1 表示最后一根网格线），一行独占。 */
.mdc-panel {
  grid-column: 1 / -1;
  width: 100%;
}
.mdc-panel .mdc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3, 12px);
  margin-bottom: var(--space-3, 12px);
  flex-wrap: wrap;
}
.mdc-panel .mdc-title-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-3, 12px);
  min-width: 0;
}
.mdc-panel .mdc-legend {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: var(--text-xs, 11px);
  color: var(--text-tertiary, rgba(148, 163, 184, .9));
  letter-spacing: .02em;
  white-space: nowrap;
}
.mdc-panel .mdc-legend i {
  display: inline-block;
  width: 14px;
  height: 0;
  border-top: 2px solid currentColor;
  margin-right: 3px;
  vertical-align: middle;
}
.mdc-panel .mdc-legend .mdc-l1 {
  color: #3b82f6;
}
.mdc-panel .mdc-legend .mdc-l2 {
  border-top-style: dashed;
  color: #94a3b8;
  margin-left: 10px;
}
.mdc-panel .mdc-ctrl {
  display: flex;
  align-items: center;
  gap: var(--space-2, 8px);
  flex-wrap: wrap;
}
.mdc-panel .mdc-segs {
  display: inline-flex;
  gap: 2px;
  background: var(--surface-default, rgba(255, 255, 255, .04));
  border-radius: var(--radius-sm, 6px);
  padding: 2px;
}
.mdc-panel .mdc-seg {
  padding: 3px var(--space-3, 12px);
  border: none;
  border-radius: var(--radius-sm, 6px);
  background: transparent;
  color: var(--text-secondary, rgba(203, 213, 225, .9));
  font-size: var(--text-xs, 11px);
  font-weight: var(--weight-medium, 500);
  cursor: pointer;
  transition: all var(--duration-fast, .15s);
  font-family: inherit;
}
.mdc-panel .mdc-seg:hover {
  color: var(--text-primary, #f1f5f9);
}
.mdc-panel .mdc-seg[data-on="1"] {
  background: var(--accent, #3b82f6);
  color: #fff;
}
.mdc-panel .mdc-tab {
  padding: 3px var(--space-3, 12px);
  border: none;
  border-radius: var(--radius-sm, 6px);
  background: transparent;
  color: var(--text-secondary, rgba(203, 213, 225, .9));
  font-size: var(--text-xs, 11px);
  font-weight: var(--weight-medium, 500);
  cursor: pointer;
  transition: all var(--duration-fast, .15s);
  font-family: inherit;
}
.mdc-panel .mdc-tab:hover {
  color: var(--text-primary, #f1f5f9);
}
.mdc-panel .mdc-tab[data-on="1"] {
  background: var(--surface-raised, rgba(255, 255, 255, .1));
  color: var(--text-primary, #f1f5f9);
}

/* KPI 三卡 */
.mdc-panel .mdc-kpis {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3, 12px);
  margin-bottom: var(--space-3, 12px);
}
.mdc-panel .mdc-kpi {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: var(--space-3, 10px) var(--space-4, 14px);
  border-radius: var(--radius-md, 8px);
  background: var(--surface-default, rgba(255, 255, 255, .03));
  border: 1px solid oklch(70% .06 210 / .10);
}
.mdc-panel .mdc-kpi-k {
  font-size: var(--text-xs, 11px);
  color: var(--text-tertiary, rgba(148, 163, 184, .9));
  letter-spacing: .04em;
}
.mdc-panel .mdc-kpi-v {
  font-size: 20px;
  font-weight: var(--weight-semibold, 600);
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.mdc-panel .mdc-kpi-s {
  font-size: var(--text-xs, 11px);
  color: var(--text-tertiary, rgba(148, 163, 184, .7));
}

/* 曲线 */
.mdc-panel .mdc-chart {
  border-radius: var(--radius-md, 8px);
  padding: 4px 2px 2px;
  color: var(--text-secondary, #cbd5e1);
}
.mdc-panel .mdc-chart svg {
  max-width: 100%;
}

/* 基线条 */
.mdc-panel .mdc-baseline {
  display: flex;
  align-items: center;
  gap: var(--space-3, 12px);
  flex-wrap: wrap;
  margin-top: var(--space-3, 12px);
  padding-top: var(--space-3, 10px);
  border-top: 1px solid oklch(70% .06 210 / .10);
}
.mdc-panel .mdc-bl-h {
  font-size: var(--text-xs, 11px);
  color: var(--text-tertiary, rgba(148, 163, 184, .9));
  letter-spacing: .04em;
  text-transform: uppercase;
}
.mdc-panel .mdc-bl {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-xs, 11px);
  color: var(--text-secondary, rgba(203, 213, 225, .9));
  font-variant-numeric: tabular-nums;
}
.mdc-panel .mdc-bl i {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex: 0 0 auto;
}
.mdc-panel .mdc-bl-n {
  color: var(--text-primary, #f1f5f9);
  font-weight: var(--weight-medium, 500);
}
.mdc-panel .mdc-bl-v2 {
  color: var(--text-tertiary, rgba(148, 163, 184, .8));
}

.mdc-panel .mdc-empty {
  padding: var(--space-6, 28px) 0;
  text-align: center;
  font-size: var(--text-sm, 13px);
  color: var(--text-tertiary, rgba(148, 163, 184, .8));
}

/* 亮色主题：参考线与网格需要更强的对比 */
:root[data-theme="light"] .mdc-panel .mdc-kpi,
html.light .mdc-panel .mdc-kpi {
  background: rgba(15, 23, 42, .03);
}
