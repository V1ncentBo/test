    .nav-item.mc-sub { display:none; align-items:center; padding-left:52px !important; }
    .nav-item.mc-sub .nav-label { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    /* 需求①②：被移入子级的原始顶级项在顶级隐藏（用属性选择器而非 JS 加类——Vue 重渲染会重写 class，类会被抹掉） */
