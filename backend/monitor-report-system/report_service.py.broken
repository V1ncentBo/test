"""
报表生成核心服务
═══════════════════════════════════════════════
日报 → 简洁快照，当前模板
周报 → 7日趋势 + 告警统计 + 设备健康 + AI 分析
月报 → 30日趋势 + 热力图 + 容量规划 + 健康评分 + AI 深度分析
"""
import json
import logging
from sqlalchemy import text
from datetime import datetime, timedelta
from typing import Optional, Dict, List, Any
from collections import defaultdict
import statistics

logger = logging.getLogger("report_service")

# ============================================================
#  核心报表生成器
# ============================================================

class ReportGenerator:
    """
    报表生成器 - 统一入口
    根据 report_type 自动选择对应的方法链
    """

    def __init__(self, db_session, influx_client, ai_client=None):
        self.db = db_session
        self.influx = influx_client
        self.ai = ai_client

    # ── 主入口 ─────────────────────────────────────────────

    def generate(self, report_type: str, period_start=None, period_end=None) -> dict:
        """统一生成入口"""
        now = datetime.now()

        if report_type == "daily":
            if not period_start:
                period_start = now.replace(hour=0, minute=0, second=0, microsecond=0)
                period_end = now
            report = self._generate_daily(period_start, period_end)

        elif report_type == "weekly":
            if not period_start:
                # 本周一到今天
                period_start = now - timedelta(days=now.weekday())
                period_start = period_start.replace(hour=0, minute=0, second=0)
                period_end = now
            report = self._generate_weekly(period_start, period_end)

        elif report_type == "monthly":
            if not period_start:
                # 本月 1 号到今天
                period_start = now.replace(day=1, hour=0, minute=0, second=0)
                period_end = now
            report = self._generate_monthly(period_start, period_end)

        else:
            raise ValueError(f"Unknown report type: {report_type}")

        # 附加元数据
        report["generated_at"] = now.isoformat()
        report["version"] = "2.0"
        return report

    # ════════════════════════════════════════════════════════
    #  日报 (Daily Report) — 简洁快照，保持现有模板
    # ════════════════════════════════════════════════════════

    def _generate_daily(self, start: datetime, end: datetime) -> dict:
        """日报：基础指标快照 + 告警汇总 + 设备状态"""
        machines = self._get_all_machines()
        summary = self._get_period_summary(start, end, machines)

        report = {
            "report_type": "daily",
            "title": f"日报 - {start.strftime('%Y年%m月%d日')}",
            "period_start": start.isoformat(),
            "period_end": end.isoformat(),
            # 概览
            "overview": {
                "date": start.strftime("%Y-%m-%d"),
                "total_devices": len(machines),
                "online_devices": summary["online_count"],
                "offline_devices": summary["offline_count"],
                "total_alerts": summary["alert_count"],
                "resolved_alerts": summary["resolved_count"],
            },
            # 今日指标快照
            "metrics_snapshot": summary["snapshot"],
            # 告警列表
            "alerts": self._get_alerts_for_period(start, end),
            # 设备状态表
            "device_status": self._get_device_status_list(machines, summary),
            # AI 摘要（日报仅一行总结）
            "ai_summary": None,
        }

        # AI 生成一句话总结
        if self.ai:
            report["ai_summary"] = self._ai_daily_summary(report)

        return report

    # ════════════════════════════════════════════════════════
    #  周报 (Weekly Report) — 趋势 + 统计 + 设备健康 + AI 分析
    # ════════════════════════════════════════════════════════

    def _generate_weekly(self, start: datetime, end: datetime) -> dict:
        """周报：7日趋势 + 告警统计 + 设备健康 + AI 分析建议"""
        machines = self._get_all_machines()

        # 7天每日汇总
        daily_trends = self._get_daily_trends(start, end, machines)

        # 告警详细统计
        alert_stats = self._get_weekly_alert_stats(start, end, machines)

        # 设备健康评分 (0-100)
        health_scores = self._calculate_health_scores(start, end, machines)

        # 峰值分析
        peak_analysis = self._analyze_peaks(start, end, machines)

        report = {
            "report_type": "weekly",
            "title": f"周报 - 第{start.isocalendar()[1]}周 ({start.strftime('%Y.%m.%d')} - {end.strftime('%m.%d')})",
            "period_start": start.isoformat(),
            "period_end": end.isoformat(),

            # === 概览 ===
            "overview": {
                "week_label": f"第{start.isocalendar()[1]}周",
                "date_range": f"{start.strftime('%m/%d')} - {end.strftime('%m/%d')}",
                "total_devices": len(machines),
                "avg_online_rate": self._calc_online_rate(machines, daily_trends),
                "total_alerts": alert_stats["total"],
                "avg_health_score": round(statistics.mean([h["score"] for h in health_scores]), 1) if health_scores else 0,
            },

            # === 7日趋势 ===
            "daily_trends": daily_trends,

            # === 告警统计 ===
            "alert_statistics": alert_stats,

            # === 峰值分析 ===
            "peak_analysis": peak_analysis,

            # === 设备健康度 ===
            "health_scores": health_scores,

            # === AI 分析 ===
            "ai_analysis": None,
        }

        # AI 综合分析
        if self.ai:
            report["ai_analysis"] = self._ai_weekly_analysis(report)

        return report

    # ════════════════════════════════════════════════════════
    #  月报 (Monthly Report) — 30日趋势 + 热力图 + 容量规划 + 健康评分
    # ════════════════════════════════════════════════════════

    def _generate_monthly(self, start: datetime, end: datetime) -> dict:
        """月报：最全面的分析报告"""
        machines = self._get_all_machines()

        # 30日每日趋势
        daily_trends = self._get_daily_trends(start, end, machines, resolution="1h")

        # 告警模式分析
        alert_patterns = self._analyze_alert_patterns(start, end)

        # 资源利用率热力图数据
        heatmap_data = self._generate_heatmap_data(start, end, machines)

        # 容量规划
        capacity_plan = self._capacity_planning(start, end, machines)

        # SLA 达标率
        sla_report = self._calculate_sla(start, end, machines)

        # 健康评分
        health_scores = self._calculate_health_scores(start, end, machines)

        # 成本优化建议
        cost_optimization = self._analyze_cost_optimization(machines)

        report = {
            "report_type": "monthly",
            "title": f"月报 - {start.strftime('%Y年%m月')}",
            "period_start": start.isoformat(),
            "period_end": end.isoformat(),

            # === 概览 ===
            "overview": {
                "month": start.strftime("%Y年%m月"),
                "date_range": f"{start.strftime('%m/%d')} - {end.strftime('%m/%d')}",
                "total_devices": len(machines),
                "avg_online_rate": self._calc_online_rate(machines, daily_trends),
                "avg_health_score": round(statistics.mean([h["score"] for h in health_scores]), 1) if health_scores else 0,
                "sla_compliance": sla_report["overall"],
                "alert_highlights": alert_patterns["highlights"],
            },

            # === 30日趋势 ===
            "daily_trends": daily_trends,

            # === 资源利用率热力图 ===
            "heatmap": heatmap_data,

            # === 告警模式分析 ===
            "alert_patterns": alert_patterns,

            # === 容量规划 ===
            "capacity_planning": capacity_plan,

            # === SLA 达标报告 ===
            "sla_report": sla_report,

            # === 设备健康评分 ===
            "health_scores": health_scores,

            # === 成本优化建议 ===
            "cost_optimization": cost_optimization,

            # === AI 深度分析 ===
            "ai_analysis": None,
        }

        if self.ai:
            report["ai_analysis"] = self._ai_monthly_analysis(report)

        return report

    # ────────────────────────────────────────────────────────
    #  数据采集方法
    # ────────────────────────────────────────────────────────

    def _get_all_machines(self) -> List[dict]:
        """获取所有设备列表"""
        result = self.db.execute(text("""
            SELECT id, name, ip_address, machine_type, status, tags, parent_id, group_name
            FROM machine_info WHERE status != 'deleted'
            ORDER BY group_name, name
        """)
        return [dict(row) for row in result]

    def _get_period_summary(self, start: datetime, end: datetime, machines: list) -> dict:
        """获取时间段内的指标汇总"""
        machine_ids = [m["id"] for m in machines]
        if not machine_ids:
            return {
                "online_count": 0, "offline_count": 0,
                "alert_count": 0, "resolved_count": 0,
                "snapshot": {"cpu": {"avg": 0, "max": 0}, "memory": {"avg": 0, "max": 0}, "disk": {"avg": 0, "max": 0}},
            }

        # InfluxDB 查询聚合指标
        try:
            # CPU
            query = f'''
            from(bucket: "machine_metrics")
              |> range(start: {int(start.timestamp())}, stop: {int(end.timestamp())})
              |> filter(fn: (r) => r["_measurement"] == "metrics")
              |> filter(fn: (r) => r["_field"] == "cpu_percent")
              |> group()
              |> mean() as avg_cpu
            '''
            # 简化处理，后续根据实际 influx query API 调整

            snapshot = self._query_metrics_aggregate(start, end)

        except Exception as e:
            logger.warning(f"InfluxDB query failed, using fallback: {e}")
            snapshot = {"cpu": {"avg": 0, "max": 0}, "memory": {"avg": 0, "max": 0}, "disk": {"avg": 0, "max": 0}}

        # MySQL 设备在线状态
        online_count = sum(1 for m in machines if m.get("status") == "online")
        offline_count = len(machines) - online_count

        # MySQL 告警统计
        alerts = self.db.execute(text("""
            SELECT COUNT(*) as total,
                   SUM(CASE WHEN status = 'resolved' THEN 1 ELSE 0 END) as resolved
            FROM alert_log
            WHERE created_at BETWEEN :start AND :end
        """, {"start": start, "end": end}).fetchone()

        return {
            "online_count": online_count,
            "offline_count": offline_count,
            "alert_count": alerts["total"] if alerts else 0,
            "resolved_count": alerts["resolved"] if alerts else 0,
            "snapshot": snapshot,
        }

    def _query_metrics_aggregate(self, start: datetime, end: datetime) -> dict:
        """
        从 InfluxDB 查询时间段内的聚合指标
        使用 InfluxDB client SDK
        """
        metrics = {"cpu": {"avg": 0, "max": 0, "min": 0, "p95": 0},
                   "memory": {"avg": 0, "max": 0, "min": 0},
                   "disk": {"avg": 0, "max": 0, "min": 0}}

        if not self.influx:
            return metrics

        try:
            for field, buckets in [("cpu_percent", "cpu"), ("mem_used_percent", "memory"), ("disk_used_percent", "disk")]:
                query_api = self.influx.query_api()
                flux = f'''
                from(bucket: "machine_metrics")
                  |> range(start: {int(start.timestamp())}, stop: {int(end.timestamp())})
                  |> filter(fn: (r) => r._measurement == "metrics")
                  |> filter(fn: (r) => r._field == "{field}")
                  |> group()
                  |> mean()
                '''
                tables = query_api.query(flux)
                values = []
                for table in tables:
                    for record in table.records:
                        values.append(record.get_value())

                if values:
                    metrics[buckets]["avg"] = round(statistics.mean(values), 2)
                    metrics[buckets]["max"] = round(max(values), 2)
                    metrics[buckets]["min"] = round(min(values), 2)
                    if buckets == "cpu" and len(values) >= 20:
                        metrics[buckets]["p95"] = self._p95(values)

        except Exception as e:
            logger.error(f"Failed to query InfluxDB aggregate: {e}")

        return metrics

    def _get_daily_trends(self, start: datetime, end: datetime, machines: list, resolution="1d") -> list:
        """获取每日趋势数据 (日/周/月都可用)"""
        trends = []
        current = start

        while current <= end:
            if resolution == "1d":
                day_end = min(current + timedelta(days=1), end)
            else:
                day_end = min(current + timedelta(hours=1), end)

            metrics = self._query_metrics_aggregate(current, day_end)

            alert_count = self.db.execute(text("""
                SELECT COUNT(*) as cnt FROM alert_log
                WHERE created_at BETWEEN :s AND :e
            """, {"s": current, "e": day_end}).fetchone()

            trends.append({
                "date": current.strftime("%Y-%m-%d"),
                "hour": current.strftime("%H:00") if resolution != "1d" else None,
                "cpu_avg": metrics["cpu"]["avg"],
                "cpu_max": metrics["cpu"]["max"],
                "mem_avg": metrics["memory"]["avg"],
                "mem_max": metrics["memory"]["max"],
                "disk_avg": metrics["disk"]["avg"],
                "alert_count": alert_count["cnt"] if alert_count else 0,
            })

            if resolution == "1d":
                current += timedelta(days=1)
            else:
                current += timedelta(hours=1)

        return trends

    def _get_alerts_for_period(self, start: datetime, end: datetime) -> list:
        """获取时间段内的告警列表"""
        alerts = self.db.execute(text("""
            SELECT a.id, a.machine_id, m.name as machine_name,
                   a.alert_type, a.severity, a.message,
                   a.status, a.created_at, a.resolved_at
            FROM alert_log a
            LEFT JOIN machine_info m ON a.machine_id = m.id
            WHERE a.created_at BETWEEN :start AND :end
            ORDER BY a.severity DESC, a.created_at DESC
            LIMIT 50
        """, {"start": start, "end": end})
        return [dict(row) for row in alerts]

    def _get_device_status_list(self, machines: list, summary: dict) -> list:
        """生成设备状态列表"""
        status_list = []
        for m in machines:
            status_list.append({
                "id": m["id"],
                "name": m["name"],
                "ip": m.get("ip_address", ""),
                "type": m.get("machine_type", "unknown"),
                "group": m.get("group_name", ""),
                "status": m.get("status", "unknown"),
            })
        return status_list

    # ────────────────────────────────────────────────────────
    #  周报专用分析
    # ────────────────────────────────────────────────────────

    def _get_weekly_alert_stats(self, start: datetime, end: datetime, machines: list) -> dict:
        """告警周统计：按日期、按严重程度、按设备"""
        # 按日期
        by_date = self.db.execute(text("""
            SELECT DATE(created_at) as date,
                   COUNT(*) as count,
                   SUM(CASE WHEN severity = 'critical' THEN 1 ELSE 0 END) as critical,
                   SUM(CASE WHEN severity = 'warning' THEN 1 ELSE 0 END) as warning,
                   SUM(CASE WHEN severity = 'info' THEN 1 ELSE 0 END) as info
            FROM alert_log
            WHERE created_at BETWEEN :start AND :end
            GROUP BY DATE(created_at)
            ORDER BY date
        """, {"start": start, "end": end})

        # 按设备 Top5
        by_device = self.db.execute(text("""
            SELECT m.name, COUNT(*) as count
            FROM alert_log a
            JOIN machine_info m ON a.machine_id = m.id
            WHERE a.created_at BETWEEN :start AND :end
            GROUP BY a.machine_id
            ORDER BY count DESC
            LIMIT 5
        """, {"start": start, "end": end})

        # 按类型
        by_type = self.db.execute(text("""
            SELECT alert_type, COUNT(*) as count
            FROM alert_log
            WHERE created_at BETWEEN :start AND :end
            GROUP BY alert_type
            ORDER BY count DESC
        """, {"start": start, "end": end})

        return {
            "total": sum(row["count"] for row in by_date) if by_date else 0,
            "by_date": [dict(row) for row in by_date],
            "top_devices": [dict(row) for row in by_device],
            "by_type": [dict(row) for row in by_type],
        }

    def _analyze_peaks(self, start: datetime, end: datetime, machines: list) -> dict:
        """峰值分析：找出CPU/内存/磁盘的峰值设备和时间"""
        peaks = {"cpu": [], "memory": [], "disk": []}

        if not self.influx or not machines:
            return peaks

        try:
            for field, key in [("cpu_percent", "cpu"), ("mem_used_percent", "memory"), ("disk_used_percent", "disk")]:
                query_api = self.influx.query_api()
                flux = f'''
                from(bucket: "machine_metrics")
                  |> range(start: {int(start.timestamp())}, stop: {int(end.timestamp())})
                  |> filter(fn: (r) => r._measurement == "metrics")
                  |> filter(fn: (r) => r._field == "{field}")
                  |> group(columns: ["machine_id"])
                  |> max()
                  |> sort(columns: ["_value"], desc: true)
                  |> limit(n: 5)
                '''
                tables = query_api.query(flux)
                for table in tables:
                    for record in table.records:
                        machine_id = record.values.get("machine_id", "")
                        machine_name = next(
                            (m["name"] for m in machines if str(m["id"]) == str(machine_id)), machine_id
                        )
                        peaks[key].append({
                            "machine": machine_name,
                            "value": round(record.get_value(), 2),
                            "time": record.get_time().isoformat() if record.get_time() else None,
                        })
        except Exception as e:
            logger.error(f"Failed to analyze peaks: {e}")

        return peaks

    def _calculate_health_scores(self, start: datetime, end: datetime, machines: list) -> list:
        """
        设备健康评分 (0-100)
        算法：CPU 负载(25分) + 内存使用(25分) + 磁盘使用(20分) + 告警频率(20分) + 在线率(10分)
        """
        scores = []
        for m in machines:
            # 获取设备指标
            metrics = self._query_device_metrics(m["id"], start, end)

            cpu_score = self._score_cpu(metrics.get("cpu_avg", 0))
            mem_score = self._score_memory(metrics.get("mem_avg", 0))
            disk_score = self._score_disk(metrics.get("disk_avg", 0))

            # 告警频率评分
            alert_count = self.db.execute(text("""
                SELECT COUNT(*) as cnt FROM alert_log
                WHERE machine_id = :mid AND created_at BETWEEN :s AND :e
            """, {"mid": m["id"], "s": start, "e": end}).fetchone()["cnt"]

            alert_score = max(0, 20 - alert_count * 2)  # 每次告警扣 2 分

            # 在线率评分
            online_score = 10 if m.get("status") == "online" else 0

            total = cpu_score + mem_score + disk_score + alert_score + online_score

            # 评级
            if total >= 90:
                grade = "A"
                grade_label = "优秀"
            elif total >= 75:
                grade = "B"
                grade_label = "良好"
            elif total >= 60:
                grade = "C"
                grade_label = "一般"
            else:
                grade = "D"
                grade_label = "需关注"

            scores.append({
                "machine_id": m["id"],
                "machine_name": m["name"],
                "score": total,
                "grade": grade,
                "grade_label": grade_label,
                "breakdown": {
                    "cpu": cpu_score,
                    "memory": mem_score,
                    "disk": disk_score,
                    "alerts": alert_score,
                    "online": online_score,
                },
                "metrics": metrics,
            })

        return sorted(scores, key=lambda x: x["score"])

    def _score_cpu(self, avg_cpu: float) -> int:
        if avg_cpu < 30: return 25
        if avg_cpu < 50: return 22
        if avg_cpu < 70: return 18
        if avg_cpu < 85: return 12
        return 5

    def _score_memory(self, avg_mem: float) -> int:
        if avg_mem < 50: return 25
        if avg_mem < 70: return 22
        if avg_mem < 85: return 18
        if avg_mem < 95: return 12
        return 5

    def _score_disk(self, avg_disk: float) -> int:
        if avg_disk < 50: return 20
        if avg_disk < 70: return 17
        if avg_disk < 85: return 13
        if avg_disk < 95: return 8
        return 3

    def _query_device_metrics(self, machine_id: int, start: datetime, end: datetime) -> dict:
        """查询特定设备的聚合指标"""
        metrics = {"cpu_avg": 0, "cpu_max": 0, "mem_avg": 0, "mem_max": 0, "disk_avg": 0, "disk_max": 0}
        if not self.influx:
            return metrics

        try:
            for field, key_avg, key_max in [
                ("cpu_percent", "cpu_avg", "cpu_max"),
                ("mem_used_percent", "mem_avg", "mem_max"),
                ("disk_used_percent", "disk_avg", "disk_max"),
            ]:
                query_api = self.influx.query_api()
                flux = f'''
                from(bucket: "machine_metrics")
                  |> range(start: {int(start.timestamp())}, stop: {int(end.timestamp())})
                  |> filter(fn: (r) => r._measurement == "metrics")
                  |> filter(fn: (r) => r._field == "{field}")
                  |> filter(fn: (r) => r.machine_id == "{machine_id}")
                '''
                tables = query_api.query(flux)
                values = [r.get_value() for table in tables for r in table.records]
                if values:
                    metrics[key_avg] = round(statistics.mean(values), 2)
                    metrics[key_max] = round(max(values), 2)
        except Exception as e:
            logger.error(f"Failed to query device {machine_id} metrics: {e}")

        return metrics

    def _calc_online_rate(self, machines: list, trends: list) -> float:
        """计算平均在线率"""
        if not machines:
            return 0.0
        online = sum(1 for m in machines if m.get("status") == "online")
        return round(online / len(machines) * 100, 1)

    # ────────────────────────────────────────────────────────
    #  月报专用分析
    # ────────────────────────────────────────────────────────

    def _analyze_alert_patterns(self, start: datetime, end: datetime) -> dict:
        """告警模式分析：高频时段、持续时长、根因分布"""
        # 按小时分布
        by_hour = self.db.execute(text("""
            SELECT HOUR(created_at) as hour, COUNT(*) as count
            FROM alert_log
            WHERE created_at BETWEEN :start AND :end
            GROUP BY HOUR(created_at)
            ORDER BY count DESC
        """, {"start": start, "end": end})

        # 告警持续时长分布（从创建到解决）
        durations = self.db.execute(text("""
            SELECT severity, alert_type,
                   AVG(TIMESTAMPDIFF(MINUTE, created_at, resolved_at)) as avg_duration_min,
                   MAX(TIMESTAMPDIFF(MINUTE, created_at, resolved_at)) as max_duration_min
            FROM alert_log
            WHERE created_at BETWEEN :start AND :end
              AND resolved_at IS NOT NULL
            GROUP BY severity, alert_type
            ORDER BY avg_duration_min DESC
        """, {"start": start, "end": end})

        # 高频告警类型（Top 5）
        top_patterns = self.db.execute(text("""
            SELECT alert_type, COUNT(*) as count,
                   COUNT(DISTINCT DATE(created_at)) as active_days
            FROM alert_log
            WHERE created_at BETWEEN :start AND :end
            GROUP BY alert_type
            ORDER BY count DESC
            LIMIT 5
        """, {"start": start, "end": end})

        return {
            "highlights": {
                "total_alerts": sum(h["count"] for h in (by_hour or [])),
                "peak_hours": [dict(row) for row in (by_hour or [])][:3],
                "top_patterns": [dict(row) for row in (top_patterns or [])],
            },
            "by_hour": [dict(row) for row in (by_hour or [])],
            "resolution_durations": [dict(row) for row in (durations or [])],
            "alert_pattern_summary": self._summarize_patterns(by_hour, top_patterns),
        }

    def _summarize_patterns(self, by_hour, top_patterns) -> str:
        """生成告警模式文字总结"""
        if not by_hour:
            return "本月无告警记录。"
        peak_hours = sorted(enumerate([row["count"] for row in by_hour]), key=lambda x: x[1], reverse=True)[:3]
        peak_str = "、".join([f"{h}:00" for h, _ in peak_hours])
        return f"告警高发时段集中在 {peak_str}，建议重点巡检。"

    def _generate_heatmap_data(self, start: datetime, end: datetime, machines: list) -> dict:
        """
        资源利用率热力图数据
        格式：[机器名, 日期, CPU使用率] 用于 ECharts heatmap
        按月报生成 30 天 × N 台设备的矩阵
        """
        heatmap = {"cpu": [], "memory": [], "disk": []}
        if not self.influx or not machines:
            return heatmap

        try:
            for field, key in [("cpu_percent", "cpu"), ("mem_used_percent", "memory"), ("disk_used_percent", "disk")]:
                query_api = self.influx.query_api()
                flux = f'''
                from(bucket: "machine_metrics")
                  |> range(start: {int(start.timestamp())}, stop: {int(end.timestamp())})
                  |> filter(fn: (r) => r._measurement == "metrics")
                  |> filter(fn: (r) => r._field == "{field}")
                  |> aggregateWindow(every: 1d, fn: mean)
                '''
                tables = query_api.query(flux)

                for table in tables:
                    machine_id = None
                    for record in table.records:
                        if machine_id is None:
                            machine_id = record.values.get("machine_id", "")
                        machine_name = next(
                            (m["name"] for m in machines if str(m["id"]) == str(machine_id)), str(machine_id)
                        )
                        date_str = record.get_time().strftime("%Y-%m-%d")
                        heatmap[key].append([machine_name, date_str, round(record.get_value(), 2)])

        except Exception as e:
            logger.error(f"Failed to generate heatmap: {e}")

        return heatmap

    def _capacity_planning(self, start: datetime, end: datetime, machines: list) -> dict:
        """
        容量规划：基于历史趋势预测未来资源需求
        使用线性回归预估 CPU/内存/磁盘的增长趋势
        """
        plans = []
        for m in machines:
            metrics = self._query_device_metrics(m["id"], start, end)

            # 简易线性趋势预测
            cpu_trend = self._estimate_resource_trend(m["id"], "cpu_percent", start, end)
            mem_trend = self._estimate_resource_trend(m["id"], "mem_used_percent", start, end)
            disk_trend = self._estimate_resource_trend(m["id"], "disk_used_percent", start, end)

            # 判断是否需要扩容
            needs_scale = False
            reasons = []

            if metrics["cpu_avg"] > 70 or cpu_trend.get("predicted_30d", 0) > 85:
                needs_scale = True
                reasons.append(f"CPU 30天后预估 {cpu_trend.get('predicted_30d', 'N/A')}%，建议扩容")
            if metrics["mem_avg"] > 75 or mem_trend.get("predicted_30d", 0) > 90:
                needs_scale = True
                reasons.append(f"内存 30天后预估 {mem_trend.get('predicted_30d', 'N/A')}%，建议扩容")
            if metrics["disk_avg"] > 80:
                needs_scale = True
                reasons.append(f"磁盘使用率已达 {metrics['disk_avg']}%，建议清理或扩容")

            plans.append({
                "machine_id": m["id"],
                "machine_name": m["name"],
                "current": metrics,
                "trends": {"cpu": cpu_trend, "memory": mem_trend, "disk": disk_trend},
                "needs_scale_up": needs_scale,
                "recommendations": reasons if reasons else ["资源充足，无需扩容"],
            })

        return {
            "devices": plans,
            "devices_need_attention": [p for p in plans if p["needs_scale_up"]],
        }

    def _estimate_resource_trend(self, machine_id: int, field: str, start: datetime, end: datetime) -> dict:
        """简易线性回归预测资源使用趋势"""
        result = {"predicted_30d": 0, "trend_direction": "stable", "slope": 0}
        if not self.influx:
            return result

        try:
            query_api = self.influx.query_api()
            flux = f'''
            from(bucket: "machine_metrics")
              |> range(start: {int(start.timestamp())}, stop: {int(end.timestamp())})
              |> filter(fn: (r) => r._measurement == "metrics")
              |> filter(fn: (r) => r._field == "{field}")
              |> filter(fn: (r) => r.machine_id == "{machine_id}")
              |> aggregateWindow(every: 1d, fn: mean)
            '''
            tables = query_api.query(flux)
            values = [r.get_value() for table in tables for r in table.records]

            if len(values) < 3:
                return result

            # 简单线性回归: y = mx + b
            n = len(values)
            x = list(range(n))
            x_mean = statistics.mean(x)
            y_mean = statistics.mean(values)

            numerator = sum((xi - x_mean) * (yi - y_mean) for xi, yi in zip(x, values))
            denominator = sum((xi - x_mean) ** 2 for xi in x)
            slope = numerator / denominator if denominator != 0 else 0

            # 30天后预测值
            predicted = y_mean + slope * (n + 30)
            result["predicted_30d"] = round(predicted, 2)
            result["slope"] = round(slope, 4)

            if slope > 0.5:
                result["trend_direction"] = "上升"
            elif slope < -0.5:
                result["trend_direction"] = "下降"
            else:
                result["trend_direction"] = "平稳"

        except Exception as e:
            logger.error(f"Failed to estimate trend for {machine_id}/{field}: {e}")

        return result

    def _calculate_sla(self, start: datetime, end: datetime, machines: list) -> dict:
        """SLA 达标率计算"""
        if not machines:
            return {"overall": 100.0, "details": []}

        total_online = 0
        total_checks = 0
        details = []

        for m in machines:
            # 从 InfluxDB 或日志统计在线时长
            uptime = self._query_uptime(m["id"], start, end)
            total_hours = (end - start).total_seconds() / 3600
            sla = min(100.0, round(uptime / max(total_hours, 1) * 100, 2))

            total_online += uptime
            total_checks += total_hours

            details.append({
                "machine_name": m["name"],
                "uptime_hours": round(uptime, 1),
                "total_hours": round(total_hours, 1),
                "sla_pct": sla,
            })

        overall_sla = round(total_online / max(total_checks, 1) * 100, 2)
        return {"overall": overall_sla, "details": details}

    def _query_uptime(self, machine_id: int, start: datetime, end: datetime) -> float:
        """查询设备在线时长 (小时)"""
        # 简化：根据状态统计
        online = self.db.execute(text("""
            SELECT COUNT(*) as cnt FROM alert_log
            WHERE machine_id = :mid AND alert_type = 'offline'
              AND created_at BETWEEN :s AND :e
        """, {"mid": machine_id, "s": start, "e": end}).fetchone()

        total_seconds = (end - start).total_seconds()
        offline_seconds = (online["cnt"] or 0) * 60  # 假设每次离线约60秒检测
        return max(0, (total_seconds - offline_seconds) / 3600)

    def _analyze_cost_optimization(self, machines: list) -> dict:
        """成本优化建议"""
        low_usage = []
        over_provisioned = []

        for m in machines:
            # 查询近30天的平均使用率
            metrics = self._query_device_metrics(m["id"], datetime.now() - timedelta(days=30), datetime.now())

            if metrics["cpu_avg"] < 10 and metrics["mem_avg"] < 30:
                low_usage.append({
                    "machine_name": m["name"],
                    "cpu_avg": metrics["cpu_avg"],
                    "mem_avg": metrics["mem_avg"],
                    "suggestion": "严重低负载，考虑降配或合并到其他设备",
                })
            elif metrics["cpu_avg"] < 20 and metrics["mem_avg"] < 40:
                low_usage.append({
                    "machine_name": m["name"],
                    "cpu_avg": metrics["cpu_avg"],
                    "mem_avg": metrics["mem_avg"],
                    "suggestion": "轻度低负载，可考虑降配",
                })

        total_savings = len(low_usage) * 500  # 粗略估算每台月省500元

        return {
            "low_usage_devices": low_usage,
            "total_low_usage_count": len(low_usage),
            "estimated_monthly_savings": total_savings,
            "recommendations": [
                f"{d['machine_name']}: {d['suggestion']}" for d in low_usage
            ],
        }

    # ────────────────────────────────────────────────────────
    #  AI 分析集成
    # ────────────────────────────────────────────────────────

    def _ai_daily_summary(self, report: dict) -> str:
        """日报 AI 一句话总结"""
        if not self.ai:
            return "AI 分析未启用。"

        overview = report["overview"]
        prompt = f"""
请用一句话总结今天的监控情况（50字以内）：
- 设备总数：{overview['total_devices']}，在线：{overview['online_devices']}
- 告警数：{overview['total_alerts']}，已解决：{overview['resolved_alerts']}
- 平均CPU: {report['metrics_snapshot'].get('cpu',{}).get('avg',0)}%，
  平均内存: {report['metrics_snapshot'].get('memory',{}).get('avg',0)}%
"""
        try:
            return self.ai.chat(prompt)
        except Exception as e:
            logger.error(f"AI daily summary failed: {e}")
            return "AI 分析暂时不可用。"

    def _ai_weekly_analysis(self, report: dict) -> dict:
        """周报 AI 综合分析"""
        if not self.ai:
            return {"summary": "AI 分析未启用。", "sections": []}

        prompt = self._build_weekly_prompt(report)
        try:
            response = self.ai.chat(prompt)
            return {
                "summary": response,
                "sections": self._parse_ai_sections(response),
                "generated_at": datetime.now().isoformat(),
            }
        except Exception as e:
            logger.error(f"AI weekly analysis failed: {e}")
            return {"summary": "AI 分析暂时不可用。", "sections": []}

    def _ai_monthly_analysis(self, report: dict) -> dict:
        """月报 AI 深度分析"""
        if not self.ai:
            return {"summary": "AI 分析未启用。", "sections": []}

        prompt = self._build_monthly_prompt(report)
        try:
            response = self.ai.chat(prompt)
            return {
                "summary": response,
                "sections": self._parse_ai_sections(response),
                "generated_at": datetime.now().isoformat(),
            }
        except Exception as e:
            logger.error(f"AI monthly analysis failed: {e}")
            return {"summary": "AI 分析暂时不可用。", "sections": []}

    def _build_weekly_prompt(self, report: dict) -> str:
        """构建周报 AI 分析 prompt"""
        overview = report["overview"]
        alert_stats = report.get("alert_statistics", {})
        peaks = report.get("peak_analysis", {})

        peak_cpu = peaks.get("cpu", [])
        top_cpu_device = peak_cpu[0]["machine"] if peak_cpu else "无"

        prompt = f"""
你是一个运维专家，请分析本周（{overview['date_range']}）监控数据并给出专业建议：

【基本概况】
- 管理设备数：{overview['total_devices']}台，在线率：{overview['avg_online_rate']}%
- 健康评分均值：{overview['avg_health_score']}/100
- 告警总数：{alert_stats.get('total', 0)}

【峰值情况】
- CPU 峰值设备：{top_cpu_device}

【分析要求】
请从以下角度分析（每个角度 2-3 句话）：
1. 整体趋势判断
2. 主要风险点
3. 下周优化建议
4. 需要重点关注的事项
"""
        return prompt

    def _build_monthly_prompt(self, report: dict) -> str:
        """构建月报 AI 分析 prompt"""
        overview = report["overview"]
        capacity = report.get("capacity_planning", {})

        needs_attention = capacity.get("devices_need_attention", [])

        prompt = f"""
你是一个运维架构师，请深度分析本月（{overview['month']}）监控数据并输出专业报告：

【核心指标】
- 设备数：{overview['total_devices']}台，SLA达标率：{overview['sla_compliance']}%
- 健康评分均值：{overview['avg_health_score']}/100

【容量预警】
- 需扩容设备：{len(needs_attention)} 台

【分析要求】
请从以下角度深入分析（每个角度 3-5 句话）：
1. 本月运维整体评价
2. 资源趋势分析与容量规划建议
3. 告警模式分析与根因推断
4. 成本优化机会
5. 下月重点工作建议
6. 架构演进方向
"""
        return prompt

    def _parse_ai_sections(self, response: str) -> list:
        """解析 AI 返回的段落为结构化数据"""
        sections = []
        for line in response.strip().split("\n"):
            line = line.strip()
            if line and (line[0].isdigit() or "：" in line[:5]):
                sections.append({"content": line})
            elif line:
                if sections:
                    sections[-1]["content"] += "\n" + line
                else:
                    sections.append({"content": line})
        return sections

    # ────────────────────────────────────────────────────────
    #  工具方法
    # ────────────────────────────────────────────────────────

    @staticmethod
    def _p95(values: list) -> float:
        """计算 P95 值"""
        if not values:
            return 0.0
        sorted_vals = sorted(values)
        idx = int(len(sorted_vals) * 0.95)
        return round(sorted_vals[min(idx, len(sorted_vals) - 1)], 2)

    @staticmethod
    def _percentile(values: list, pct: float) -> float:
        """通用百分位数"""
        if not values:
            return 0.0
        sorted_vals = sorted(values)
        idx = int(len(sorted_vals) * pct / 100)
        return round(sorted_vals[min(idx, len(sorted_vals) - 1)], 2)
