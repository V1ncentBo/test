.main-area .stat-card::after{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--bar,var(--mc-bar-1))}
.main-area .stat-card:hover{transform:translateY(-3px);box-shadow:var(--mc-shadow-hover);transition:transform .2s,box-shadow .2s}
.main-area .stat-card .stat-top{display:flex;align-items:center;gap:10px;margin-bottom:6px}
